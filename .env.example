# Copy to .env (never commit the real one)
PORT=8000
DATABASE_PATH=/data/sentineltrace.db
API_KEY=                 # set a long random value to require X-API-Key on every /api call
SEED_DEMO=1              # 1 = analyse sample emails on first start (good for demos); 0 for real use
RETENTION_DAYS=0         # delete analyses older than N days (0 = keep)
MAX_UPLOAD_MB=10
RATE_LIMIT_PER_MIN=30    # per client IP, per worker
BEHIND_PROXY=1           # 1 when behind Render/Nginx/Cloudflare so client IPs are correct
LOG_LEVEL=INFO
WEB_CONCURRENCY=2
